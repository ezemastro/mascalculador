# SMTP para recuperación de contraseña (Hostinger).
# Si no se definen, el enlace se loguea en la consola del server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BASE_URL=http://localhost:5174
# Asistente virtual (LLM vía OpenRouter). Sin key, el endpoint /api/assistant
# responde 503 y el widget del frontend se oculta.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
