{
  "name": "mascalculador",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:steel\" \"npm run dev:concrete\"",
    "dev:steel": "npm run dev --workspace=apps/steel",
    "dev:concrete": "npm run dev --workspace=apps/concrete",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck:all": "tsc -b",
    "lint:all": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.39.1",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
