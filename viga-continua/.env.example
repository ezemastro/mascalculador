# Copiá este archivo a .env y completá los valores.
# En producción (Coolify), definí estas mismas variables en el entorno del servicio.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=tu-mail@dominio.com
SMTP_PASS=tu-contraseña
SMTP_FROM="Tu Nombre <tu-mail@dominio.com>"
BASE_URL=https://tu-dominio.com

# Asistente virtual (LLM vía OpenRouter). Sin key, el endpoint /api/assistant
# responde 503 y el widget del frontend muestra el error.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Cadena de modelos (fallback): el primero que responda gana.
OPENROUTER_MODELS=